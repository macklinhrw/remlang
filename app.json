{
  "expo": {
    "name": "remlang",
    "slug": "remlang",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.macklinrw.remlang"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.macklinrw.remlang"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      [
        "expo-sqlite",
        {
          "version": 1,
          "name": "remlang",
          "enableFTS": true,
          "customBuildFlags": [
            "-DSQLITE_ENABLE_MATH_FUNCTIONS=1"
          ]
        }
      ],
      [
        "expo-asset",
        {
          "assets": [
            "./assets/database.db"
          ]
        }
      ],
      "expo-font",
      "expo-web-browser",
      "@clerk/expo",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "cdab28a1-0a82-4174-a743-2ee34c007e40"
      }
    },
    "runtimeVersion": "1.0.0",
    "updates": {
      "url": "https://u.expo.dev/cdab28a1-0a82-4174-a743-2ee34c007e40"
    }
  }
}
