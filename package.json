{
	"name": "remlang",
	"main": "expo-router/entry",
	"version": "1.0.0",
	"scripts": {
		"start": "expo start",
		"android": "expo run:android",
		"ios": "expo run:ios",
		"web": "expo start --web",
		"test": "tsx --test \"lib/**/*.test.ts\" \"scripts/**/*.test.ts\" && pnpm run test:backend",
		"test:backend": "cd backend && bun test",
		"typecheck": "tsc --noEmit",
		"lint": "expo lint",
		"generate:tobira-decks": "npx tsx ./scripts/generateTobiraDecks.ts",
		"fetch:resources": "tsx ./scripts/fetch-resources.ts",
		"fetch:db": "tsx ./scripts/fetch-db.ts",
		"db:pack": "tsx ./scripts/pack-db.ts",
