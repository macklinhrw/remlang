# Copy to .env. Everything here is optional: with nothing set, the app runs
# fully offline (no accounts, no cloud sync, no premade decks).

# Accounts + cloud sync (https://clerk.com, free dev instance)
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Sync API base URL (run ./backend locally: http://localhost:8787)
EXPO_PUBLIC_SYNC_API_URL=

# Native build identity (see app.config.ts)
APP_ID=
EXPO_OWNER=
EAS_PROJECT_ID=

# Only for scripts/generateTobiraDecks.ts (LLM-assisted sense matching)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Only for scripts/generateTobiraDecks.ts: your own copy of the Tobira vocab TSVs
TOBIRA_SOURCE_ROOT=
